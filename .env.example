# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace-with-32-char-random-secret-key
LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=utap
DB_PASSWORD=change-me-strong-password
DB_NAME=utap_db
DATABASE_URL=postgresql://utap:change-me-strong-password@db:5432/utap_db

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
S3_BUCKET_NAME=utap-unit-test-artefacts-prod
S3_PRESIGNED_URL_EXPIRY=3600
MAX_UPLOAD_SIZE_MB=25

# ── Azure AD SAML 2.0 ─────────────────────────────────────────────────────────
SAML_ENTITY_ID=https://utap.company.com/saml/metadata
SAML_ACS_URL=https://utap.company.com/saml/acs
SAML_SLO_URL=https://utap.company.com/saml/logout

# SP certificate and private key (PEM format, no line breaks — use \n)
SAML_CERT=-----BEGIN CERTIFICATE-----\nMIIC...your SP cert here...\n-----END CERTIFICATE-----
SAML_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIE...your SP key here...\n-----END RSA PRIVATE KEY-----

# Azure AD IdP settings (from Enterprise App → SAML → Federation Metadata)
AZURE_AD_ENTITY_ID=https://sts.windows.net/YOUR-TENANT-ID/
AZURE_AD_SSO_URL=https://login.microsoftonline.com/YOUR-TENANT-ID/saml2
AZURE_AD_CERT=-----BEGIN CERTIFICATE-----\nMIIC...IdP cert from Azure portal...\n-----END CERTIFICATE-----
AZURE_AD_METADATA_URL=https://login.microsoftonline.com/YOUR-TENANT-ID/federationmetadata/2007-06/federationmetadata.xml

# ── Azure AD Group Names ──────────────────────────────────────────────────────
AZURE_GROUP_DEVELOPER=UTAP_Developer
AZURE_GROUP_REVIEWER=UTAP_Reviewer
AZURE_GROUP_RELEASE_MANAGER=UTAP_Release_Manager
AZURE_GROUP_ADMIN=UTAP_Admin

# ── Session / Security ────────────────────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=30
COOKIE_SECURE=true
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["https://utap.company.com"]

# ── Evidence Thresholds ───────────────────────────────────────────────────────
EVIDENCE_COMPLETENESS_THRESHOLD=90.0
